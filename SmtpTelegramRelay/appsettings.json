{
  // ===== Example configuration =====
  // This file is just an example. Put your real values into:
  //   appsettings.develop.json    - when ASPNETCORE_ENVIRONMENT=Develop
  //   appsettings.production.json - default (or ASPNETCORE_ENVIRONMENT=Production)
  //
  // Both files are in .gitignore, so your secrets are never committed.
  //
  // The port that the relay will listen on to receive SMTP e-mail messages, the default is 25.
  // No authorization is required when connecting to this port, select Basic Authorizathion if it is required
  "SmtpPort": 5025,
  // Your token for the Telegram bot, get it at https://t.me/BotFather when registering the bot
  "TelegramBotToken": "PASTE_YOUR_TELEGRAM_BOT_TOKEN",
  "UseProxy": false,
  "Proxy": "socks5://user:password@proxy.example.com:1080",
  "HttpAddress": "*",
  "HttpPort": 5026,
  "SmtpAddress": "*",
  // Define here a list of email addresses and telegram chats that will receive emails sent to these addresses.
  // Use an asterisk "*" instead of an email address to send all emails to some telegram chat.
  // Example:
  //   "Routing": [
  //     {
  //       "EmailTo": "*",
  //       "EmailFrom": "backup@example.com",
  //       "TelegramChatId": 123456789,
  //       "Prefixes": [
  //         {
  //           "RegexpSubject": "\\ASuccess",
  //           "Prefix": "🟢 "
  //         }
  //       ],
  //       "Actions": [
  //         {
  //           "Name": "more",
  //           "Command": "c:\\Tools\\scripts\\run.ps1"
  //         }
  //       ]
  //     }
  //   ]
  "Routing": [],
  // Logging Level. Set to Debug to see the details of the communication between your mail program and the relay.
  // Set to Error to see less information
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  // NLog settings. Writes logs to the console and to a file in the logs folder.
  // To see more or fewer details change "minlevel" of the last rule below.
  // You can override any part of this section in appsettings.develop.json or appsettings.production.json.
  "NLog": {
    "internalLogLevel": "Warn",
    "internalLogFile": "logs/internal.txt",
    "extensions": [
      {
        "assembly": "NLog.Web.AspNetCore"
      }
    ],
    "targets": {
      "File": {
        "type": "File",
        "fileName": "logs/${shortdate}.log",
        "layout": {
          "type": "CsvLayout",
          "quoting": "Auto",
          "withHeader": false,
          "delimiter": "Tab",
          "columns": [
            { "name": "DateTime", "layout": "${longdate}" },
            { "name": "Severity", "layout": "${uppercase:${level}}" },
            { "name": "Message", "layout": "${message}" },
            { "name": "Exception", "layout": "${exception:format=tostring}" }
          ]
        }
      },
      "Console": {
        "type": "ColoredConsole"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "minlevel": "Info",
        "writeTo": "Console, File",
        "final": true
      },
      {
        "logger": "System.Net.Http.*",
        "minlevel": "Info",
        "writeTo": "Console, File",
        "final": true
      },
      {
        "logger": "*",
        "minlevel": "Info",
        "writeTo": "Console, File"
      }
    ]
  }
}
